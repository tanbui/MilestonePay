# Milestone Pay configuration. Copy to .env.local and fill in what you have.
# Everything is optional: with no values the app runs on mock PayPal,
# mock AI and in-memory mock data.

# --- PayPal (sandbox) --------------------------------------------------------
# From https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id shown after you add https://<your-app>/api/paypal/webhook to the sandbox app.
PAYPAL_WEBHOOK_ID=
# Force mock mode even when credentials are set: PAYPAL_MODE=mock
PAYPAL_MODE=
# Local testing only: accept webhooks without verifying the signature.
PAYPAL_SKIP_WEBHOOK_VERIFY=
# Optional sandbox accounts so every invoice and payout lands somewhere you can log in to.
# Create them under Testing Tools > Sandbox Accounts.
DEMO_CLIENT_EMAIL=
DEMO_PAYOUT_EMAIL=

# --- Claude -------------------------------------------------------------------
# From https://console.anthropic.com. Without a key the app uses a deterministic mock.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Force mock AI even when a key is set: AI_MODE=mock
AI_MODE=

# --- Data ---------------------------------------------------------------------
# Postgres URL (Neon, Supabase, Vercel Postgres). Use the pooled URL on Vercel/Netlify.
# Without it, data lives in memory and resets when the server restarts.
DATABASE_URL=

# --- App ----------------------------------------------------------------------
APP_TIMEZONE=America/Los_Angeles
AGENCY_NAME=Lotus Dev Studio
DEFAULT_TERM_DAYS=15
# Pin "today" (YYYY-MM-DD) for a repeatable demo recording.
DEMO_TODAY=
# Protects /api/agent/sweep. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=
